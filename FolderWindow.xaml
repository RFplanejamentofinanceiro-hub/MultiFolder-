<Window x:Class="DesktopFolders.FolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopFolders"
        Title="Pasta inteligente" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="#B0000000" ShowInTaskbar="False" Topmost="True"
        AllowDrop="True" Drop="Win_Drop" DragOver="Win_DragOver" DragEnter="Win_DragOver" KeyDown="Window_KeyDown" MouseLeftButtonDown="Bg_Click">

    <Window.Resources>
        <!-- Cores do tema (trocadas em tempo de execução por ApplyTheme) -->
        <SolidColorBrush x:Key="PanelBg" Color="#F01E2230" />
        <SolidColorBrush x:Key="PanelBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="TextMain" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextDim" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="HoverBg" Color="#33FFFFFF" />

        <DataTemplate x:Key="Tile" DataType="{x:Type local:Entry}">
            <Border x:Name="T" Width="92" Height="104" Margin="6" CornerRadius="10" Background="#01000000"
                    AllowDrop="True" Drop="Tile_Drop"
                    MouseLeftButtonDown="Tile_Down" MouseMove="Tile_Move" MouseLeftButtonUp="Tile_Up"
                    MouseRightButtonUp="Tile_RightClick">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
                    <Image Source="{Binding Icon}" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMain}" FontFamily="Segoe UI" FontSize="12"
                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="34" Margin="4,6,4,0" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="T" Property="IsMouseOver" Value="True">
                    <Setter TargetName="T" Property="Background" Value="{DynamicResource HoverBg}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="28" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" Padding="24,20,24,16" HorizontalAlignment="Center" VerticalAlignment="Center"
            MinWidth="380" MaxWidth="640" MouseLeftButtonDown="Panel_Click">
        <StackPanel>
            <TextBlock x:Name="FolderTitle" Foreground="{DynamicResource TextMain}" FontFamily="Segoe UI" FontSize="22"
                       FontWeight="SemiBold" TextAlignment="Center" />
            <Border x:Name="AccentBar" Height="3" Width="56" CornerRadius="2" Margin="0,8,0,14" HorizontalAlignment="Center" />
            <ItemsControl x:Name="List" ItemTemplate="{StaticResource Tile}" MinHeight="104">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource TextDim}" FontFamily="Segoe UI" FontSize="13"
                       TextAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="Pasta vazia. Arraste programas ou atalhos para cá, ou use o botão abaixo." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="+ Adicionar programa" Click="Add_Click" Padding="14,6" Margin="0,0,8,0" />
                <Button Content="Exportar..." Click="Export_Click" Padding="14,6" />
            </StackPanel>

            <!-- Aparência: tema e cor da pasta -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button x:Name="ThemeBtn" Click="ThemeToggle_Click" Padding="10,3" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
