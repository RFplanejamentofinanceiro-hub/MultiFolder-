    <AssemblyName>DesktopFolders</AssemblyName>
    <RootNamespace>DesktopFolders</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.2.0</Version>
  </PropertyGroup>


</Project>
